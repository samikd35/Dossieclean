# DossieClean .gitignore

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials/

# ===========================
# Python
# ===========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ===========================
# Flask / Web
# ===========================
instance/
.webassets-cache

# ===========================
# Application-specific
# ===========================
# Uploads and temporary files
uploads/
temp_uploads/
tmp/
output/
*.pdf
*.PDF

# Batch processing status
batch_status/

# Logs
*.log
logs/
dossieclean.log

# Database files
*.db
*.sqlite
*.sqlite3

# Python tooling caches
.mypy_cache/
.ruff_cache/
.pytype/

# Local runtime/config extras
.python-version
.envrc

# ===========================
# IDEs & Editors
# ===========================
# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ===========================
# Operating System
# ===========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ===========================
# Docker
# ===========================
docker-compose.override.yml

# ===========================
# Documentation
# ===========================
docs/_build/
site/

# ===========================
# CI/CD
# ===========================
.github/workflows/*.secrets

# ===========================
# Dependencies
# ===========================
node_modules/
bower_components/

# ===========================
# Miscellaneous
# ===========================
*.bak
*.tmp
*.temp
*.old
.vagrant/
