[flake8]
# Maximum line length (matches Black default)
max-line-length = 100

# Maximum complexity (McCabe)
max-complexity = 10

# Ignore certain errors for Black compatibility
# E203: whitespace before ':' (Black formats this way)
# E501: line too long (handled by max-line-length)
# W503: line break before binary operator (Black prefers this)
# E266: too many leading '#' for block comment
extend-ignore = E203, W503, E266

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .tox,
    .mypy_cache,
    .pytest_cache,
    node_modules,
    migrations,
    .github

# Per-file ignores
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py: F401
    # Tests can have longer lines and more complexity
    tests/*: E501, C901

# Show source code for each error
show-source = true

# Count errors
count = true

# Statistics
statistics = true
