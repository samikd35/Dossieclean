# DossieClean Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================
# API Keys
# ===========================
# OpenAI API key for metadata extraction and embeddings
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# Azure Blob Storage
# ===========================
# Azure Storage connection string for PDF file storage
# Format: DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net
# Get from: Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=xxxxxxxxxx;EndpointSuffix=core.windows.net

# Azure Blob container name for storing PDFs
AZURE_CONTAINER_NAME=pdf-documents

# ===========================
# Qdrant Vector Database
# ===========================
# Qdrant cloud instance URL
# Get from: https://cloud.qdrant.io/
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io:6333

# Qdrant API key for authentication
QDRANT_API_KEY=your-qdrant-api-key-here

# ===========================
# Database Configuration
# ===========================
# Database name (used for organization)
DB_NAME=Dossie

# Collection name in Qdrant for storing embeddings
COLLECTION_NAME=AAU_PDF

# ===========================
# MongoDB (Legacy - Optional)
# ===========================
# Note: Currently using Azure Blob + Qdrant. MongoDB references are legacy.
# Only configure if you need MongoDB for additional features.

# MongoDB username
MONGO_USERNAME=your_mongodb_username

# MongoDB password
MONGO_PASSWORD=your_mongodb_password

# MongoDB connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://${MONGO_USERNAME}:${MONGO_PASSWORD}@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# ===========================
# Application Configuration
# ===========================
# Flask secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# Chunk size for splitting PDF text (in tokens)
# Smaller = more precise search, larger = more context per chunk
CHUNK_SIZE=512

# Chunk overlap (in tokens) to maintain context between chunks
CHUNK_OVERLAP=50

# ===========================
# Optional Settings
# ===========================
# Flask debug mode (NEVER set to True in production!)
FLASK_DEBUG=False

# Flask environment (development, production)
FLASK_ENV=production

# Application port
PORT=5000

# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=100

# ===========================
# Security Notes
# ===========================
# 1. NEVER commit this file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Use different credentials for development and production
# 4. Set strong SECRET_KEY in production (64+ characters recommended)
# 5. Enable HTTPS in production
# 6. Consider using a secrets manager (AWS Secrets Manager, Azure Key Vault) for production
